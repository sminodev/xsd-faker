{
  "name": "xsd-faker",
  "version": "0.2.0",
  "description": "Generate sample XML and JSON test data from XSD (XML Schema) files.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/locales"
  ],
  "scripts": {
    "build:locales": "tsc -p packages/locales/tsconfig.build.json",
    "build": "npm run build:locales && tsc -p tsconfig.build.json",
    "typecheck": "npm run build:locales && tsc --noEmit -p packages/locales && tsc --noEmit",
    "pretest": "npm run build:locales",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:acceptance": "npm run build && node --test test/acceptance.test.mjs",
    "test:consumer": "node test/consumer.mjs",
    "verify": "npm run typecheck && npm run lint && npm run build && npm test && node --test test/acceptance.test.mjs",
    "prepack": "npm run build && node -e \"require('node:fs').chmodSync('dist/bin.js', 0o755)\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    }
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "xmllint-wasm": "5.3.0",
    "xsd-faker-locales": "^0.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "author": "mino (https://github.com/sminodev)",
  "license": "MIT",
  "keywords": [
    "xsd",
    "xml-schema",
    "xml",
    "json",
    "xsd-to-xml",
    "xsd2xml",
    "xml-from-xsd",
    "xml-generator",
    "sample-xml",
    "sample-xml-generator",
    "test-data",
    "test-data-generator",
    "mock-data",
    "fake-data",
    "fixtures",
    "faker"
  ],
  "homepage": "https://github.com/sminodev/xsd-faker#readme",
  "bugs": {
    "url": "https://github.com/sminodev/xsd-faker/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sminodev/xsd-faker.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "examples",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "bin": {
    "xsd-faker": "./dist/bin.js"
  },
  "types": "./dist/index.d.ts",
  "overrides": {
    "minimatch": "^11.0.4"
  },
  "allowScripts": {
    "fsevents": false
  }
}
