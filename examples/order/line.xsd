<?xml version="1.0" encoding="UTF-8"?>
<!-- A line of an order; included into order.xsd, so it shares its namespace. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:example:order" xmlns:c="urn:example:common"
           targetNamespace="urn:example:order" elementFormDefault="qualified">
  <xs:import namespace="urn:example:common" schemaLocation="common/common.xsd"/>

  <xs:complexType name="Line">
    <xs:sequence>
      <xs:element name="Item" type="OfficeItem"/>
      <xs:element name="Quantity" type="OrderQuantity"/>
      <xs:element name="Price" type="c:Price" minOccurs="0"/>
      <xs:element name="Tag" type="xs:string" minOccurs="0" maxOccurs="3"/>
      <xs:element name="Packaging" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="Box" type="BoxSize"/>
            <xs:element name="Weight" type="c:Kilogram" minOccurs="0"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:simpleType name="BoxSize">
    <xs:restriction base="xs:string">
      <xs:enumeration value="S"/>
      <xs:enumeration value="M"/>
      <xs:enumeration value="L"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="OfficeItem">
    <xs:restriction base="c:Text40">
      <xs:enumeration value="Kopierpapier A4, Karton"/>
      <xs:enumeration value="Kugelschreiber, Großpackung"/>
      <xs:enumeration value="Aktenordner, Karton"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="OrderQuantity">
    <xs:restriction base="xs:positiveInteger">
      <xs:maxInclusive value="10"/>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
