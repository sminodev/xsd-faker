<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="urn:example:rule" targetNamespace="urn:example:rule"
  elementFormDefault="qualified">
  <xs:element name="order">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="currency" type="xs:string" fixed="EUR"/>
        <xs:element name="express" type="xs:boolean" fixed="1"/>
        <xs:element name="priority" type="xs:int" fixed="+5"/>
        <xs:element name="checksum" type="xs:hexBinary" fixed="0A"/>
      </xs:sequence>
      <xs:attribute name="version" type="xs:string" fixed="1.0"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
