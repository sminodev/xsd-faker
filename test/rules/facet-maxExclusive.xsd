<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="urn:example:rule" targetNamespace="urn:example:rule"
  elementFormDefault="qualified">
  <xs:element name="order">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="discount"><xs:simpleType><xs:restriction base="xs:decimal"><xs:maxExclusive value="100"/></xs:restriction></xs:simpleType></xs:element>
        <xs:element name="due"><xs:simpleType><xs:restriction base="xs:date"><xs:maxExclusive value="2030-12-31+01:00"/><xs:pattern value="\d{4}-\d{2}-\d{2}.*"/></xs:restriction></xs:simpleType></xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
