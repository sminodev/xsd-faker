{
  "name": "xsd-faker-locales",
  "version": "0.1.1",
  "description": "German and English names, addresses and contact details for test data, with a faker-js adapter.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "files": [
    "dist",
    "README.md",
    "SOURCES.md",
    "LICENSE"
  ],
  "author": "mino (https://github.com/sminodev)",
  "license": "MIT",
  "keywords": [
    "xsd-faker",
    "locale-data",
    "test-data",
    "fake-data",
    "names",
    "addresses",
    "postcodes",
    "german",
    "english",
    "faker",
    "faker-js"
  ],
  "homepage": "https://github.com/sminodev/xsd-faker/tree/main/packages/locales#readme",
  "bugs": {
    "url": "https://github.com/sminodev/xsd-faker/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sminodev/xsd-faker.git",
    "directory": "packages/locales"
  }
}
